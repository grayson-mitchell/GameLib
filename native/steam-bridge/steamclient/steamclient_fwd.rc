/* 52-26 (item 22): GameLib's own version resource for the forwarder. Carries
 * no answer and no Valve identity; it only gives the file a resource directory
 * with version strings, as the game's own image has. */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "GameLib"
      VALUE "FileDescription", "GameLib steamclient forwarder"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "steamclient_fwd"
      VALUE "OriginalFilename", "steamclient64.dll"
      VALUE "ProductName", "GameLib"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
