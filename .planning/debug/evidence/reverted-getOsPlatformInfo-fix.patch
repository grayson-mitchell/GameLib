diff --git a/src/backend/utils/systeminfo/index.ts b/src/backend/utils/systeminfo/index.ts
index 80e5c9a35..a298a8d5b 100644
--- a/src/backend/utils/systeminfo/index.ts
+++ b/src/backend/utils/systeminfo/index.ts
@@ -178,6 +178,36 @@ Software Versions:
   Nile: ${info.softwareInUse.nileVersion}`
 }
 
+/**
+ * Lightweight OS-only info (platform + OS version/name) -- debug/nile-spawn-app-side-latency.md
+ * fix. Deliberately does NOT go through `getSystemInfo()`/`fetchSystemInfo()`: that function
+ * bundles the OS read together with `Promise.all([getLegendaryVersion(), getGogdlVersion(),
+ * getCometVersion(), getNileVersion()])`, which spawns/extracts all four PyInstaller-onefile
+ * runner binaries just to determine `process.platform`/`process.getSystemVersion()`. The Login
+ * screen (`frontend/screens/Login/index.tsx`) only ever needs `OS.platform`/`OS.version` (for
+ * its "unsupported old macOS" gate) but was calling the full `getSystemInfo()` on every mount --
+ * and under the Tauri sidecar, `initHeadless()` (`backend/logger/index.ts`) deliberately skips the
+ * Electron path's boot-time system-info warm-up (Phase 27 Plan 04 deviation, Rule 3), so the
+ * Login screen's mount is the FIRST caller in a fresh session. That made "open Manage
+ * Accounts, click a login button immediately" -- the natural first user action -- land the
+ * login spawn directly on top of 4 concurrent onefile extractions triggered by the SAME mount,
+ * inflating click-to-window latency by ~25-30s. This function reuses the exact OS-assembly
+ * logic `fetchSystemInfo()` uses (same field order, same `getOsInfo()` call) but nothing else,
+ * so it never touches the runner binaries and returns near-instantly.
+ */
+async function getOsPlatformInfo(): Promise<{
+  platform: NodeJS.Platform
+  name: string
+  version: string
+}> {
+  const detailedOsInfo = await getOsInfo()
+  return {
+    platform: process.platform,
+    version: process.getSystemVersion(),
+    ...detailedOsInfo
+  }
+}
+
 /**
  * Test-only reset hook (debug/gog-spawn-reduction.md fix 3). `cachedSystemInfo` and
  * `inFlightSystemInfoFetch` are module-level singletons that outlive any individual test
@@ -190,5 +220,10 @@ function __resetSystemInfoCacheForTests(): void {
   inFlightSystemInfoFetch = null
 }
 
-export { getSystemInfo, formatSystemInfo, __resetSystemInfoCacheForTests }
+export {
+  getSystemInfo,
+  getOsPlatformInfo,
+  formatSystemInfo,
+  __resetSystemInfoCacheForTests
+}
 export type { SystemInformation, GPUInfo }
