+// Serializes every bridge round trip and every touch of g_bridge_sock. UE
+// titles call Steam from more than one thread (game thread plus the online
+// async task thread), and one shared socket with unguarded send/recv lets two
+// calls interleave frames or consume each other's response, leaving the loser
+// blocked in recv for good (debug: abiotic-factor-loading-hang). Not
+// recursive: nothing that holds it may call bridge_transact again.
+static SRWLOCK g_bridge_lock = SRWLOCK_INIT;
+
+// Diagnostic trace of bridge calls, one line per call, written beside this DLL
+// and truncated at the first call of each process. Capped so a title that
+// polls Steam every frame cannot grow it without bound. Records the calling
+// thread and whether it had to wait on g_bridge_lock -- the evidence that
+// concurrent callers exist. Written only while g_bridge_lock is held.
+#define BRIDGE_TRACE_FILENAME "gamelib_bridge_trace.log"
+#define BRIDGE_TRACE_MAX_LINES 512
+static char g_bridge_trace_path[MAX_PATH];
+static int g_bridge_trace_lines = 0;
+
