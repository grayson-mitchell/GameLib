+/* Appends one trace line. Caller holds g_bridge_lock. */
+static void bridge_trace_call(uint16_t ordinal, uint16_t slot, int contended, int ok) {
+  if (g_bridge_trace_path[0] == 0 || g_bridge_trace_lines >= BRIDGE_TRACE_MAX_LINES) return;
+  FILE *f = fopen(g_bridge_trace_path, g_bridge_trace_lines == 0 ? "wb" : "ab");
+  if (!f) return;
+  g_bridge_trace_lines++;
+  fprintf(f, "t=%lu tid=%lu ord=%u slot=%u contended=%d ok=%d\\n",
+          (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(),
+          (unsigned)ordinal, (unsigned)slot, contended, ok);
+  fclose(f);
+}
+
+/* Records a call the shim answers locally (a stub, a shim-side fallback, a
+ * callback registration), which never reaches bridge_transact. Takes
+ * g_bridge_lock itself, so it must not be called while holding it. */
+static void bridge_trace_local(const char *what, long arg) {
+  AcquireSRWLockExclusive(&g_bridge_lock);
+  if (g_bridge_trace_path[0] != 0 && g_bridge_trace_lines < BRIDGE_TRACE_MAX_LINES) {
+    FILE *f = fopen(g_bridge_trace_path, g_bridge_trace_lines == 0 ? "wb" : "ab");
+    if (f) {
+      g_bridge_trace_lines++;
+      fprintf(f, "t=%lu tid=%lu local=%s arg=%ld\\n",
+              (unsigned long)GetTickCount(), (unsigned long)GetCurrentThreadId(), what, arg);
+      fclose(f);
+    }
+  }
+  ReleaseSRWLockExclusive(&g_bridge_lock);
+}
+
+/* First call per function only, so a stub polled every frame costs one line. */
+#define BRIDGE_TRACE_ONCE(what) \\
+  do { static int traced_; if (!traced_) { traced_ = 1; bridge_trace_local((what), 0); } } while (0)
+
+static int bridge_transact(uint16_t ordinal, uint16_t slot,
+                            const uint8_t *argBuf, uint32_t argLen,
+                            uint8_t *retBuf, uint32_t retBufCap, uint32_t *retLenOut) {
+  int contended = !TryAcquireSRWLockExclusive(&g_bridge_lock);
+  if (contended) AcquireSRWLockExclusive(&g_bridge_lock);
+  int ok = bridge_transact_locked(ordinal, slot, argBuf, argLen, retBuf, retBufCap, retLenOut);
+  bridge_trace_call(ordinal, slot, contended, ok);
+  ReleaseSRWLockExclusive(&g_bridge_lock);
+  return ok;
+}
