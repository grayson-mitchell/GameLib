From 1e2bc887a598c29a6b524f093c647e278032d078 Mon Sep 17 00:00:00 2001
From: GameLib Dev <dev@gamelib.local>
Date: Mon, 10 Aug 2026 21:45:27 +1200
Subject: [PATCH] ci(macos): build nile as PyInstaller --onedir and archive it

amfid performs a per-file Gatekeeper assessment on every file --onefile
extracts to a freshly-randomized $TMPDIR/_MEIxxxxxx path on each run, so
the assessment cache never hits and every cold spawn re-assesses the
whole bundle. --onedir uses a fixed on-disk layout so the cache hits
after the first assessment. Measured locally: ~95x faster cold spawn
(20.84s -> 0.22s), ~47x warm (6.61s -> 0.14s), at a cost of ~2.2x bundle
growth (~100 extra files to sign/notarize).

macOS-only change: a new Set PyInstaller mode step computes --onedir on
macOS and --onefile everywhere else (mirroring the existing Set strip
step's per-OS pattern), followed by an archive step that tars
dist/nile into dist-archive/nile.tar.gz and uploads that in place of
the bare binary on macOS. Linux and Windows are untouched -- they do
not pay the amfid tax and would only absorb the bundle growth for no
gain.
---
 .github/workflows/build.yaml | 35 +++++++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/build.yaml b/.github/workflows/build.yaml
index e9d478b..6dbfbb1 100644
--- a/.github/workflows/build.yaml
+++ b/.github/workflows/build.yaml
@@ -24,16 +24,47 @@ jobs:
       run: echo "option=--strip" >> $GITHUB_OUTPUT
       if: runner.os != 'Windows'
 
+    # macOS-only: PyInstaller --onedir instead of --onefile. On macOS, amfid
+    # performs a per-file Gatekeeper assessment on every file --onefile
+    # extracts to a freshly-randomized $TMPDIR/_MEIxxxxxx path on every run,
+    # so that assessment cache never hits and every cold spawn re-assesses
+    # the whole bundle (measured cold-spawn win locally, see PR
+    # description). Linux and Windows do not run amfid and would only
+    # absorb --onedir's bundle growth for no gain, so only macOS's mode
+    # switches below.
+    - name: Set PyInstaller mode
+      id: mode
+      shell: bash
+      run: |
+        if [ "$RUNNER_OS" = "macOS" ]; then
+          echo "option=--onedir" >> "$GITHUB_OUTPUT"
+        else
+          echo "option=--onefile" >> "$GITHUB_OUTPUT"
+        fi
+
     - name: Build
       run: pyinstaller
-        --onefile
-        --name nile 
+        ${{ steps.mode.outputs.option }}
+        --name nile
         ${{ steps.strip.outputs.option }}
         nile/cli.py
       env:
         PYTHONOPTIMIZE: 1
 
+    - name: Archive onedir bundle (macOS)
+      if: runner.os == 'macOS'
+      run: |
+        mkdir -p dist-archive
+        tar -C dist -czf dist-archive/nile.tar.gz nile
+
     - uses: actions/upload-artifact@v4
+      if: runner.os != 'macOS'
       with:
         name: nile-${{ matrix.os }}
         path: dist/*
+
+    - uses: actions/upload-artifact@v4
+      if: runner.os == 'macOS'
+      with:
+        name: nile-${{ matrix.os }}
+        path: dist-archive/nile.tar.gz
-- 
