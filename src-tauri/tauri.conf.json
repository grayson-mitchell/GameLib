{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLib",
  "version": "0.7.0",
  "identifier": "com.gamelib.shell",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameLib",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/gamelib-sidecar"],
    "resources": ["../build/bin/"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMDJGN0UwQzlGQzA0QzcKUldUSEJQeko0UGNDbWsxcFpZU01JcVlKNFhObnVBQ3JuWjZQMUcwZFVYaGdKb1V4ekd0N1U1NncK",
      "endpoints": [
        "https://github.com/grayson-mitchell/GameLib/releases/download/updater/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
