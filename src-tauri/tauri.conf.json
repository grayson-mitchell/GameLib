{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLib",
  "version": "0.7.0",
  "identifier": "com.gamelib.shell",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm exec vite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameLib",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/gamelib-sidecar"],
    "resources": {
      "../build/locales/": "build/locales",
      "../build/changelog.json": "build/changelog.json",
      "../build/webviewPreload.js": "build/webviewPreload.js",
      "../build/icon.png": "build/icon.png"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gamelib"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMDJGN0UwQzlGQzA0QzcKUldUSEJQeko0UGNDbWsxcFpZU01JcVlKNFhObnVBQ3JuWjZQMUcwZFVYaGdKb1V4ekd0N1U1NncK",
      "endpoints": [
        "https://github.com/grayson-mitchell/GameLib/releases/download/updater/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
