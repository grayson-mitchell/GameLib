{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameLib",
  "version": "0.7.0",
  "identifier": "com.gamelib.shell",
  "build": {
    "frontendDist": "../build",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameLib",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  },
  "plugins": {}
}
