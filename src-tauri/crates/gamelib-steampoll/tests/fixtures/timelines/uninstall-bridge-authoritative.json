{
  "name": "uninstall-bridge-authoritative",
  "description": "With the bridge authoritative for install state only the bridge root is searched for a survivor (the bottle copy is ignored).",
  "machine": "uninstall",
  "platform": "darwin",
  "start": {
    "appId": "1000",
    "title": "Test Game",
    "roots": {
      "native": ["/fake/steam"],
      "bottle": "/fake/bottle/steamapps",
      "bridge": "/fake/bridge/steamapps"
    },
    "source": "native"
  },
  "store": {
    "bridgeAllowlisted": true,
    "metadata": {
      "mac_arch": "32"
    }
  },
  "ticks": [
    {
      "acf": {
        "/fake/steam/steamapps": {
          "appid": "1000",
          "name": "Test Game",
          "installdir": "TestGame",
          "stateFlags": 2048,
          "sizeOnDisk": "1048576",
          "buildid": "100",
          "bytesDownloaded": "0",
          "bytesToDownload": "0",
          "bytesStaged": "0",
          "bytesToStage": "0"
        },
        "/fake/bottle/steamapps": {
          "appid": "1000",
          "name": "Test Game",
          "installdir": "TestGame",
          "stateFlags": 4,
          "sizeOnDisk": "1048576",
          "buildid": "100"
        },
        "/fake/bridge/steamapps": {
          "appid": "1000",
          "name": "Test Game",
          "installdir": "TestGame",
          "stateFlags": 4,
          "sizeOnDisk": "1048576",
          "buildid": "100"
        }
      }
    },
    {
      "acf": {
        "/fake/steam/steamapps": null
      }
    },
    {}
  ]
}
