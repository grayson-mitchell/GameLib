  "platform": "linux",
  "first": [
    "vcrun2019",
    "d3dx9",
    "corefonts",
    "fontsmooth=rgb"
  ],
  "second": [
    "vcrun2019",
    "d3dx9",
    "corefonts",
    "fontsmooth=rgb"
