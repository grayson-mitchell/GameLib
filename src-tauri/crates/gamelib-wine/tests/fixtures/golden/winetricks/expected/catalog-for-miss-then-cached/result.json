        "type": "wine",
        "bin": "<TOOLS>/wine/Wine-9/bin/wine"
      },
      "appName": "game"
    },
    {
      "fn": "setupEnvVars",
      "wineVersion": {
        "type": "wine",
        "bin": "<TOOLS>/wine/Wine-9/bin/wine"
      }
    },
    {
      "fn": "setupWineEnvVars",
      "wineVersion": {
        "type": "wine",
        "bin": "<TOOLS>/wine/Wine-9/bin/wine"
      },
      "appName": "game"
    }
  ],
  "logs": [
