  {
    "id": "cache-stale-refetch",
    "note": "A cache older than 24 h (25 h) is refetched live and replaced. Live.",
    "platform": "mac",
    "live": true,
    "cache": {
      "index": "old",
      "ageMinutes": 1500
    },
    "ops": [
      {
        "op": "load"
      }
    ]
  },
  {
    "id": "fetch-failure-last-good-kept-then-backoff",
    "note": "A 500 on a stale cache keeps the last good bytes; a second load inside the 5 minute back-off makes no request; after 6 minutes the request is retried (and fails again).",
    "platform": "mac",
    "cache": {
      "index": "old",
      "ageMinutes": 1500
    },
    "ops": [
      {
        "op": "load"
      },
      {
        "op": "load"
      },
      {
        "op": "advance",
        "minutes": 6
      },
      {
        "op": "load"
      }
    ],
    "synthetic": [
      {
        "status": 500,
        "text": "{\"message\":\"Server Error\"}"
      }
    ]
  },
  {
    "id": "backoff-expires-then-recovers",
    "note": "A failed refresh, then after the back-off the retry succeeds with the live gz bytes and the store is replaced.",
    "platform": "mac",
    "cache": {
      "index": "old",
      "ageMinutes": 1500
    },
    "ops": [
      {
        "op": "load"
      },
      {
        "op": "advance",
        "minutes": 6
      },
      {
        "op": "load"
      }
    ],
    "synthetic": [
      {
        "status": 500,
        "text": "{}"
      },
      {
        "rawLive": true
      }
    ]
  },
