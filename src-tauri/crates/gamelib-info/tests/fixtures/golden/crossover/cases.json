  {
    "id": "second-fetch-within-24h-no-request",
    "note": "A second load inside the 24 h TTL returns the stored index with no request (idempotency edge). Live first fetch.",
    "platform": "mac",
    "live": true,
    "ops": [
      {
        "op": "load"
      },
      {
        "op": "advance",
        "minutes": 60
      },
      {
        "op": "load"
      }
    ]
  },
