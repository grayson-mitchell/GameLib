[
  {
    "id": "synthetic-search-us-cheapest-per-game-and-caches",
    "note": "search then price: one row per game from its cheapest deal, an unpriced game dropped, the thumbnail falls back banner300 to banner145 to boxart; writes search, deals and index cache entries",
    "keys": {
      "env": true
    },
    "synthetic": [
      {
        "method": "GET",
        "path": "/games/search/v1",
        "status": 200,
        "bodyJson": [
          {
            "id": "018d937f-012f-73b8-ab2c-898516969e6a",
            "title": "Half-Life 2",
            "assets": {
              "banner145": "https://a/145.jpg"
            }
          },
          {
            "id": "018d937f-1212-7232-b23f-a046f6fd4a57",
            "title": "Overwatch",
            "assets": {
              "boxart": "https://a/box.jpg"
            }
          },
          {
            "id": "018d937f-0000-7000-8000-000000000001",
            "title": "Unpriced",
            "assets": {}
          },
          {
            "id": "018d937f-1749-73f8-bf5a-8e0aa3cdd9ff",
            "title": "Portal"
          }
        ]
      },
      {
        "method": "POST",
        "path": "/games/prices/v3",
        "status": 200,
        "bodyFixture": "prices-US"
      }
    ],
    "ops": [
      {
        "op": "search",
        "query": "portal",
        "country": "US"
      }
    ]
  },
