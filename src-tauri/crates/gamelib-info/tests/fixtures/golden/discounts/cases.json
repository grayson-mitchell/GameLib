    "locale": { "countryCode": "US", "locale": "en-US", "currencyCode": "USD" },
    "live": true
  },
  {
    "id": "live-pl-locale",
    "note": "A non-US locale (PL/pl-PL/PLN) that has discounts: no US retry. Live.",
