[
  {
    "id": "knownFixLaunch--resolveknownfixexeoverride-accepts-a-relative-file-and-returns-the-lexical-path",
    "title": "resolveKnownFixExeOverride > accepts a relative file and returns the lexical path",
    "steps": [
      {
        "op": "resolve",
        "installPath": "<HOME>/games/install",
        "exeOverride": "bin/game.exe"
      }
    ]
  },
  {
