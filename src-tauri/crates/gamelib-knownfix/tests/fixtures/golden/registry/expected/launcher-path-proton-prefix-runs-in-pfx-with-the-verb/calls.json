[
  {
    "step": 0,
    "kind": "runWineCommand",
    "commandParts": [
      "reg",
      "add",
      "HKCU\\Software\\Wine\\AppDefaults\\Game.exe\\DllOverrides",
      "/v",
      "d3d9",
      "/t",
      "REG_SZ",
      "/d",
      "native,builtin",
      "/reg:64",
      "/f"
    ],
    "wait": false,
    "protonVerb": "runinprefix",
    "skipPrefixCheckIKnowWhatImDoing": null,
    "hasOnSpawn": true,
    "gameSettingsIsTheCallers": true,
    "winePrefix": "<HOME>/Games/prefix"
  },
  {
    "step": 0,
    "kind": "runner.run",
    "program": "<TOOLS>/proton/GE-Proton9-27/proton",
    "replaceEnv": true,
    "track": {
      "runner": "wine",
      "key": "<HOME>/Games/prefix"
    },
    "resolveOn": "close",
    "timeoutNone": true,
    "windowsHide": false,
    "cwd": null
  }
]
