    "engines": "installed",
    "steps": [
      {
        "call": "set",
        "key": "gog:1",
        "selection": {
          "kind": "pinned",
          "pinId": "wine-staging-11.20",
          "reason": "cx-missing",
          "wineBin": "<TOOLS>/steam-engines/wine-staging-11.20/Contents/Resources/wine/bin/wine",
          "wineserverBin": "<TOOLS>/steam-engines/wine-staging-11.20/Contents/Resources/wine/bin/wineserver",
          "label": "Pinned",
          "version": "11.20",
          "dxvk": {
            "dir": "<TOOLS>/steam-engines/dxvk-macOS-v1.10.3-20230507-repack",
            "version": "v1.10.3-20230507-repack"
          }
        },
        "mutateInput": true
      },
      {
        "call": "get",
        "key": "gog:1"
      }
    ],
    "expected": [
      {
        "call": "set",
        "key": "gog:1",
        "returned": true
      },
