  {
    "id": "refused-set-keeps-the-previous-selection",
    "note": "a refused set (missing binaries is simulated by a bad key) leaves what was stored",
    "engines": "installed",
    "steps": [
      {
        "call": "set",
        "key": "620",
        "selection": {
          "kind": "crossover",
          "reason": "cx-healthy",
          "crossoverBuild": "26.3",
          "binDir": "/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin"
        }
      },
      {
        "call": "set",
        "key": "not a key",
        "selection": {
          "kind": "pinned",
          "pinId": "wine-staging-11.20",
          "reason": "cx-missing",
          "wineBin": "<TOOLS>/steam-engines/wine-staging-11.20/Contents/Resources/wine/bin/wine",
          "wineserverBin": "<TOOLS>/steam-engines/wine-staging-11.20/Contents/Resources/wine/bin/wineserver",
          "label": "Pinned",
          "version": "11.20",
          "dxvk": {
            "dir": "<TOOLS>/steam-engines/dxvk-macOS-v1.10.3-20230507-repack",
            "version": "v1.10.3-20230507-repack"
          }
        }
      },
      {
        "call": "get",
        "key": "620"
      },
      {
        "call": "get",
        "key": "not a key"
      }
    ],
    "expected": [
      {
        "call": "set",
        "key": "620",
        "returned": true
      },
      {
        "call": "set",
        "key": "not a key",
        "returned": false
      },
      {
        "call": "get",
        "key": "620",
        "returned": {
          "kind": "crossover",
          "reason": "cx-healthy",
          "crossoverBuild": "26.3",
          "binDir": "/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin"
        }
      },
      {
        "call": "get",
        "key": "not a key",
        "returned": null
      }
    ]
  },
