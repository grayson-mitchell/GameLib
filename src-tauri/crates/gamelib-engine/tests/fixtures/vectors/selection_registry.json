[
  {
    "id": "crossover-set-get-clear",
    "note": "a CrossOver selection needs no binaries: set stores it, get returns it, clear removes it",
    "engines": "none",
    "steps": [
      {
        "call": "get",
        "key": "620"
      },
      {
        "call": "set",
        "key": "620",
        "selection": {
          "kind": "crossover",
          "reason": "cx-healthy",
          "crossoverBuild": "26.3",
          "binDir": "/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin"
        }
      },
      {
        "call": "get",
        "key": "620"
      },
      {
        "call": "clear",
        "key": "620"
      },
      {
        "call": "get",
        "key": "620"
      }
    ],
    "expected": [
      {
        "call": "get",
        "key": "620",
        "returned": null
      },
      {
        "call": "set",
        "key": "620",
        "returned": true
      },
      {
        "call": "get",
        "key": "620",
        "returned": {
          "kind": "crossover",
          "reason": "cx-healthy",
          "crossoverBuild": "26.3",
          "binDir": "/Applications/CrossOver.app/Contents/SharedSupport/CrossOver/bin"
        }
      },
      {
        "call": "clear",
        "key": "620",
        "returned": null
      },
      {
        "call": "get",
        "key": "620",
        "returned": null
      }
    ]
  },
