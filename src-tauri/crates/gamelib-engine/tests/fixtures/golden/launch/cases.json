      },
      {
        "op": "prime",
        "selection": "crossover",
        "prefix": "bottle"
      },
      {
        "op": "overlay",
        "action": "get"
      },
      {
        "op": "settings",
        "stored": {
          "winePrefix": "<HOME>/old-prefix"
        }
      },
      {
        "op": "overlay",
        "action": "set",
        "prefix": "bottle",
        "binDir": "<HOME>/Other/bin"
      },
      {
        "op": "settings",
        "stored": {
