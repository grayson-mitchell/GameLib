  {
    "id": "deadline-fires-no-match-no-raise",
    "note": "WR-02: the deadline fires with no process seen: one notification, no raise, no modal, nothing stopped, the launch stays held, the notice is pushed in-app",
    "steps": [
      {
        "op": "select"
      },
      {
        "op": "arm",
        "watcher": "real",
        "listing": [
          [
            "  310 /usr/sbin/cfprefsd agent",
            "  311 /Applications/Other.app/Contents/MacOS/Other"
          ]
        ]
      },
      {
        "op": "advance",
        "ms": 180000
      },
      {
        "op": "advance",
        "ms": 200000
      }
    ]
  },
