[
  {
    "program": "gamemoderun",
    "argv": [
      "mangohud",
      "<TOOLS>/toolkit/bin/wine64",
      "<HOME>/Games/Game/game.exe",
      "-flag"
    ],
    "env": {
      "APPDATA": "<HOME>/AppData/Roaming",
      "HOME": "<HOME>",
      "LANG": "C.UTF-8",
      "LD_PRELOAD": "",
      "LOCALAPPDATA": "<HOME>/AppData/Local",
      "MY_VAR": "quoted value",
      "PATH": "/usr/bin:/bin",
      "PROTON_LOG": "1",
      "PROTON_VERB": "waitforexitandrun",
      "USER": "gamelib-oracle",
      "USERPROFILE": "<HOME>",
      "WINEPREFIX": "<HOME>/Games/prefix",
      "WINE_FULLSCREEN_FSR": "0",
      "XDG_CACHE_HOME": "<HOME>/.cache",
      "XDG_CONFIG_HOME": "<HOME>/.config",
      "XDG_DATA_HOME": "<HOME>/.local/share",
      "XDG_STATE_HOME": "<HOME>/.local/state"
    },
    "cwd": "<HOME>/Games/Game",
    "replaceEnv": true,
    "resolveOn": "exit",
    "track": {
      "runner": "wine",
      "key": "<HOME>/Games/prefix"
    },
    "timeout": {
      "none": true,
      "reason": "a wine command runs as long as the game or installer it hosts; the caller cancels through killTracked or its own deadline"
    },
    "timeoutMs": null,
    "windowsHide": false,
    "hasSignal": false,
    "callSite": "runner.wine_command.launch",
    "class": "game"
  },
  {
    "program": "<TOOLS>/toolkit/bin/wineserver",
    "argv": [
      "--wait"
    ],
    "env": {
      "APPDATA": "<HOME>/AppData/Roaming",
      "HOME": "<HOME>",
      "LANG": "C.UTF-8",
      "LD_PRELOAD": "",
      "LOCALAPPDATA": "<HOME>/AppData/Local",
      "MY_VAR": "quoted value",
      "PATH": "/usr/bin:/bin",
      "PROTON_LOG": "1",
      "PROTON_VERB": "waitforexitandrun",
      "USER": "gamelib-oracle",
      "USERPROFILE": "<HOME>",
      "WINEPREFIX": "<HOME>/Games/prefix",
      "WINE_FULLSCREEN_FSR": "0",
      "XDG_CACHE_HOME": "<HOME>/.cache",
      "XDG_CONFIG_HOME": "<HOME>/.config",
      "XDG_DATA_HOME": "<HOME>/.local/share",
      "XDG_STATE_HOME": "<HOME>/.local/state"
    },
    "cwd": "<HOME>/Games/Game",
    "replaceEnv": true,
    "resolveOn": null,
    "track": null,
    "timeout": null,
    "timeoutMs": 1800000,
    "windowsHide": false,
    "hasSignal": false,
    "callSite": "runner.wine_command.wineserver_wait",
    "class": "helper"
  }
]
