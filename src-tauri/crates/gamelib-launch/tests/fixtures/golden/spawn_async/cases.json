[
  {
    "id": "spawn-async-plain",
    "note": "the end-to-end tracer: spawn, onOutput order and result of one createSpawnAsync call",
    "command": "tar",
    "args": [
      "-xf",
      "a"
    ],
    "options": {
      "cwd": "/x"
    },
    "observe": true,
    "script": [
      {
        "chunks": [
          {
            "stream": "stdout",
            "text": "o1"
          },
          {
            "stream": "stderr",
            "text": "e1"
          },
          {
            "stream": "stdout",
            "text": "o2"
          },
          {
            "stream": "stderr",
            "text": "e2"
          },
          {
            "stream": "stdout",
            "text": "o3"
          }
        ],
        "code": 0
      }
    ]
  },
  {
