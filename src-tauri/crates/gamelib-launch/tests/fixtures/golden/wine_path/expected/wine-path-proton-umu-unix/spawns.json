[
  {
    "program": "<TOOLS>/runtimes/umu/umu_run.py",
    "argv": [
      "cmd",
      "/c",
      "winepath",
      "-u",
      "C:\\Games\\Game One\\save"
    ],
    "env": {
      "APPDATA": "<HOME>/AppData/Roaming",
      "HOME": "<HOME>",
      "LANG": "C.UTF-8",
      "LD_PRELOAD": "",
      "LOCALAPPDATA": "<HOME>/AppData/Local",
      "MY_VAR": "quoted value",
      "PATH": "/usr/bin:/bin",
      "PROTONPATH": "<TOOLS>/proton/GE-Proton9-1",
      "PROTON_DISABLE_NVAPI": "1",
      "PROTON_LOG_DIR": "<HOME>",
      "PROTON_NO_ESYNC": "1",
      "PROTON_NO_FSYNC": "1",
      "PROTON_VERB": "runinprefix",
      "STEAM_COMPAT_APP_ID": "0",
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "<HOME>/.steam/steam",
      "STEAM_COMPAT_DATA_PATH": "<HOME>/Games/prefix",
      "SteamAppId": "0",
      "SteamGameId": "heroic-0",
      "USER": "gamelib-oracle",
      "USERPROFILE": "<HOME>",
      "WINEPREFIX": "<HOME>/Games/prefix",
      "WINE_FULLSCREEN_FSR": "0",
      "XDG_CACHE_HOME": "<HOME>/.cache",
      "XDG_CONFIG_HOME": "<HOME>/.config",
      "XDG_DATA_HOME": "<HOME>/.local/share",
      "XDG_STATE_HOME": "<HOME>/.local/state"
    },
    "cwd": null,
    "replaceEnv": true,
    "resolveOn": "close",
    "track": {
      "runner": "wine",
      "key": "<HOME>/Games/prefix"
    },
    "timeout": {
      "none": true,
      "reason": "a wine command runs as long as the game or installer it hosts; the caller cancels through killTracked or its own deadline"
    },
    "timeoutMs": null,
    "windowsHide": false,
    "hasSignal": false,
    "callSite": "runner.wine_path",
    "class": "helper"
  }
]
