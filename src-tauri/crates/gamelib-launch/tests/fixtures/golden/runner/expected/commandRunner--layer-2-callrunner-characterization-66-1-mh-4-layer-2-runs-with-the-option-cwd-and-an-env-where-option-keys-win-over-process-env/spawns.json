[
  {
    "program": "gogdl",
    "argv": [
      "list",
      "l1-env"
    ],
    "env": {
      "APPDATA": "<HOME>/AppData/Roaming",
      "HOME": "<HOME>",
      "L2_ENV_OPT": "opt",
      "L2_ENV_SENTINEL": "from-process",
      "L2_ENV_SHARED": "from-options",
      "LANG": "C.UTF-8",
      "LOCALAPPDATA": "<HOME>/AppData/Local",
      "PATH": "/usr/bin:/bin",
      "USER": "gamelib-oracle",
      "USERPROFILE": "<HOME>",
      "XDG_CACHE_HOME": "<HOME>/.cache",
      "XDG_CONFIG_HOME": "<HOME>/.config",
      "XDG_DATA_HOME": "<HOME>/.local/share",
      "XDG_STATE_HOME": "<HOME>/.local/state"
    },
    "cwd": "<TMP>/l1/cwd",
    "replaceEnv": true,
    "resolveOn": null,
    "track": {
      "runner": "gog",
      "key": "0.4242"
    },
    "timeout": {
      "none": true,
      "reason": "store CLI downloads and installs run for as long as the transfer takes; the user cancels through the abort controller or killTracked"
    },
    "timeoutMs": null,
    "windowsHide": false,
    "hasSignal": true,
    "callSite": "runner.call",
    "class": "helper"
  }
]
