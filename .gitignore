.env

playwright-report

# macOS native Steam bridge (Phase 24, D-07) -- the shim SOURCE
# (native/steam-bridge/generated/*.c/*.def) is generated but COMMITTED
# (deterministic, code-reviewable, pinned to the manifest sdkVersion). Only
# the built PE binary (compiled at packaging time, Plan 24-07) is ignored.
native/steam-bridge/generated/*.dll

# Phase 24 Plan 07 (R5): the pinned zig toolchain meta/downloadZig.ts
# extracts is a build-time-only tool, never bundled/committed.
/.build-tools/

# Knowledge graphs. graphify-out/ is the live standalone-`graphify`-CLI graph
# (large, regenerable via `graphify update .`, never committed).
# .planning/graphs/ is the retired GSD-skill duplicate -- ignored so it cannot
# come back.
graphify-out/
.planning/graphs/
