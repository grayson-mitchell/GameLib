{
  "channels": {
    "logError": {
      "kind": "send",
      "slice": "logger",
      "args": [
        {
          "name": "message",
          "type": "string | string[] | { name?: string, message?: string, stack?: string }",
          "strict": true
        }
      ],
      "returns": "void",
      "valid": [
        ["x"],
        [["a", "b"]],
        [{ "name": "E", "message": "m", "stack": "s" }],
        [{}]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [["a", 1]],
        [{ "extra": "x" }],
        [{ "message": 1 }],
        ["a", "b"]
      ]
    },
    "logInfo": {
      "kind": "send",
      "slice": "logger",
      "args": [
        {
          "name": "message",
          "type": "string | string[] | { name?: string, message?: string, stack?: string }",
          "strict": true
        }
      ],
      "returns": "void",
      "valid": [
        ["x"],
        [["a", "b"]],
        [{ "name": "E", "message": "m", "stack": "s" }],
        [{}]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [["a", 1]],
        [{ "extra": "x" }],
        [{ "message": 1 }],
        ["a", "b"]
      ]
    },
    "getHeroicVersion": {
      "kind": "invoke",
      "slice": "app-shell",
      "args": [],
      "returns": "string",
      "valid": [[]],
      "invalid": [["extra"], [null], [1, 2]]
    },
    "openExternalUrl": {
      "kind": "send",
      "slice": "app-shell",
      "args": [
        {
          "name": "url",
          "type": "string",
          "maxLength": 8192,
          "maxLengthUnit": "utf16",
          "format": "url"
        }
      ],
      "returns": "void",
      "valid": [
        ["https://example.com/a"],
        ["steam://rungameid/220"],
        ["mailto:a@b.c"],
        ["tel:+15551234"]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [""],
        ["file:///etc/passwd"],
        ["javascript:alert(1)"],
        ["https://"],
        ["http://exa mple.com"],
        ["https://a", "extra"]
      ]
    }
  }
}
