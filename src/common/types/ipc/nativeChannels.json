    "steamgriddb.getHeroes": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "query",
          "type": "{ gameId, styles?, dimensions? }",
          "strict": true
        }
      ],
      "returns": "[{ id, url, thumb }]",
      "valid": [
        [{ "gameId": 1 }],
        [
          {
            "gameId": 13136,
            "styles": ["alternate"],
            "dimensions": ["1920x620"]
          }
        ]
      ],
      "invalid": [
        [],
        [{}],
        [{ "gameId": 0 }],
        [{ "gameId": "1" }],
        [{ "gameId": 1, "extra": 1 }],
