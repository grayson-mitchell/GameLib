    "steamgriddb.setApiKey": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "key",
          "type": "string",
          "maxLength": 256,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "void",
      "valid": [["abcdef0123"], [""]],
      "invalid": [[], [1], [null], ["a", "b"], [{}]]
    },
