{
  "channels": {
    "logError": {
      "kind": "send",
      "slice": "logger",
      "args": [
        {
          "name": "message",
          "type": "string | string[] | { name?: string, message?: string, stack?: string }",
          "strict": true
        }
      ],
      "returns": "void",
      "valid": [
        ["x"],
        [["a", "b"]],
        [{ "name": "E", "message": "m", "stack": "s" }],
        [{}]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [["a", 1]],
        [{ "extra": "x" }],
        [{ "message": 1 }],
        ["a", "b"]
      ]
    },
    "logInfo": {
      "kind": "send",
      "slice": "logger",
      "args": [
        {
          "name": "message",
          "type": "string | string[] | { name?: string, message?: string, stack?: string }",
          "strict": true
        }
      ],
      "returns": "void",
      "valid": [
        ["x"],
        [["a", "b"]],
        [{ "name": "E", "message": "m", "stack": "s" }],
        [{}]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [["a", 1]],
        [{ "extra": "x" }],
        [{ "message": 1 }],
        ["a", "b"]
      ]
    },
    "getLogContent": {
      "kind": "invoke",
      "slice": "logger",
      "args": [
        {
          "name": "logFile",
          "type": "{} | { runner } | { appName, runner, type? }",
          "strict": true
        }
      ],
      "returns": "string",
      "valid": [
        [{}],
        [{ "runner": "legendary" }],
        [{ "runner": "comet" }],
        [{ "appName": "abc", "runner": "gog" }],
        [{ "appName": "abc", "runner": "steam", "type": "install" }]
      ],
      "invalid": [
        [],
        [{ "appName": "../x", "runner": "steam" }],
        [{ "runner": "epic" }],
        [{ "appName": "a", "runner": "comet" }],
        [{ "appName": "a", "runner": "gog", "type": "crash" }],
        [{ "appName": "abc" }],
        [{ "appName": "", "runner": "gog" }],
        [{ "extra": 1 }],
        ["x"]
      ]
    },
    "uploadLogFile": {
      "kind": "invoke",
      "slice": "logger",
      "args": [
        {
          "name": "name",
          "type": "string",
          "maxLength": 1024,
          "maxLengthUnit": "utf16"
        },
        {
          "name": "logFile",
          "type": "{} | { runner } | { appName, runner, type? }",
          "strict": true
        }
      ],
      "returns": "false | [string, { name, token, uploadedAt }]",
      "valid": [
        ["Heroic log", {}],
        [
          "Game log of X",
          { "appName": "abc", "runner": "gog", "type": "launch" }
        ]
      ],
      "invalid": [
        [],
        ["x"],
        [1, {}],
        ["x", { "appName": "abc" }],
        ["x", {}, "extra"],
        [
          "",
          {}
        ],
        ["x", { "appName": "../x", "runner": "steam" }],
        ["x", { "extra": 1 }]
      ]
    },
    "getUploadedLogFiles": {
      "kind": "invoke",
      "slice": "logger",
      "args": [],
      "returns": "{ [url]: { name, token, uploadedAt } }",
      "valid": [[]],
      "invalid": [["x"], [{}], [null], [1, 2]]
    },
    "deleteUploadedLogFile": {
      "kind": "invoke",
      "slice": "logger",
      "args": [
        {
          "name": "url",
          "type": "string",
          "format": "url",
          "maxLength": 8192
        }
      ],
      "returns": "boolean",
      "valid": [
        ["https://dpaste.com/AbC123"],
        ["http://dpaste.com/AbC123"],
        ["https://evil.example/x"]
      ],
      "invalid": [
        [],
        [1],
        [null],
        [{ "url": "https://dpaste.com/AbC123" }],
        ["https://dpaste.com/AbC123", "extra"],
        ["not a url"],
        ["javascript:alert(1)"],
        ["file:///etc/passwd"]
      ]
    },
    "sidecar:store-fetch": {
      "kind": "invoke",
      "slice": "store",
      "args": [{ "name": "storeName", "type": "string", "strict": true }],
      "returns": "{ values: { [field]: unknown }, rev?: number }",
      "valid": [
        ["configStore"],
        ["wikigameinfo"],
        ["steam_library"],
        ["fontsStore"]
      ],
      "invalid": [
        [],
        [1],
        [null],
        [""],
        ["humble_library"],
        ["notAStore"],
        ["../config"],
        [
          "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        ],
        ["configStore", "extra"]
      ]
    },
    "storeSet": {
      "kind": "send",
      "slice": "store",
      "args": [
        {
          "name": "storeName",
          "type": "string",
          "maxLength": 128,
          "maxLengthUnit": "utf16"
        },
        {
          "name": "keyPath",
          "type": "string",
          "maxLength": 512,
          "maxLengthUnit": "utf16"
        },
        { "name": "value", "type": "JSON" }
      ],
      "returns": "void",
      "valid": [
        ["configStore", "defaultSettings.theme", "dark"],
        ["configStore", "a.b", { "nested": [1, 2, null] }],
        ["configStore", "a", null]
      ],
      "invalid": [
        [],
        ["configStore"],
        ["configStore", "a"],
        [1, "a", 1],
        ["s", "", 1],
        ["", "a", 1],
        ["s", "a", 1, "extra"]
      ]
    },
    "sidecar:store-set-checked": {
      "kind": "invoke",
      "slice": "store",
      "args": [
        {
          "name": "storeName",
          "type": "string",
          "maxLength": 128,
          "maxLengthUnit": "utf16"
        },
        {
          "name": "keyPath",
          "type": "string",
          "maxLength": 512,
          "maxLengthUnit": "utf16"
        },
        { "name": "value", "type": "JSON" }
      ],
      "returns": "boolean",
      "valid": [
        ["configStore", "theme", "dracula"],
        ["configStore", "customThemes", []]
      ],
      "invalid": [
        [],
        ["configStore"],
        ["", "theme", 1],
        [1, "theme", 1],
        ["configStore", "theme", 1, "extra"]
      ]
    },
    "storeDelete": {
      "kind": "send",
      "slice": "store",
      "args": [
        {
          "name": "storeName",
          "type": "string",
          "maxLength": 128,
          "maxLengthUnit": "utf16"
        },
        {
          "name": "keyPath",
          "type": "string",
          "maxLength": 512,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "void",
      "valid": [["configStore", "defaultSettings.theme"]],
      "invalid": [
        [],
        ["configStore"],
        ["configStore", ""],
        ["configStore", 1],
        ["configStore", "a", "extra"]
      ]
    },
    "storeNew": {
      "kind": "send",
      "slice": "store",
      "args": [
        {
          "name": "storeName",
          "type": "string",
          "maxLength": 128,
          "maxLengthUnit": "utf16"
        },
        { "name": "options", "type": "{ [key]: JSON } | undefined (ignored)" }
      ],
      "returns": "void",
      "valid": [
        ["timestampStore", { "cwd": "store_cache", "name": "x" }],
        ["timestampStore", null],
        ["timestampStore"]
      ],
      "invalid": [[], [""], [1, {}], ["s", "not-an-object"], ["s", {}, "extra"]]
    },
    "getHeroicVersion": {
      "kind": "invoke",
      "slice": "app-shell",
      "args": [],
      "returns": "string",
      "valid": [[]],
      "invalid": [["extra"], [null], [1, 2]]
    },
    "showLogFileInFolder": {
      "kind": "send",
      "slice": "logger",
      "args": [
        {
          "name": "logFile",
          "type": "{} | { runner } | { appName, runner, type? }",
          "strict": true
        }
      ],
      "returns": "void",
      "valid": [
        [{}],
        [{ "runner": "legendary" }],
        [{ "runner": "comet" }],
        [{ "appName": "abc", "runner": "gog" }],
        [{ "appName": "abc", "runner": "steam", "type": "install" }]
      ],
      "invalid": [
        [],
        [{ "appName": "../x", "runner": "steam" }],
        [{ "runner": "epic" }],
        [{ "appName": "a", "runner": "comet" }],
        [{ "appName": "a", "runner": "gog", "type": "crash" }],
        [{ "appName": "abc" }],
        [{ "appName": "", "runner": "gog" }],
        [{ "extra": 1 }],
        ["x"]
      ]
    },
    "openExternalUrl": {
      "kind": "send",
      "slice": "app-shell",
      "args": [
        {
          "name": "url",
          "type": "string",
          "maxLength": 8192,
          "maxLengthUnit": "utf16",
          "format": "url"
        }
      ],
      "returns": "void",
      "valid": [
        ["https://example.com/a"],
        ["steam://rungameid/220"],
        ["mailto:a@b.c"],
        ["tel:+15551234"]
      ],
      "invalid": [
        [],
        [null],
        [7],
        [""],
        ["file:///etc/passwd"],
        ["javascript:alert(1)"],
        ["https://"],
        ["http://exa mple.com"],
        ["https://a", "extra"]
      ]
    },
    "removeRecent": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "appName",
          "type": "string",
          "maxLength": 1024,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "void",
      "valid": [["abc"]],
      "invalid": [[], [1], ["a", "b"], [""]]
    },
    "getAllGameOverrides": {
      "kind": "invoke",
      "slice": "info",
      "args": [],
      "returns": "{ [appName]: { title?, art_cover?, art_square? } }",
      "valid": [[]],
      "invalid": [[1], [null]]
    },
    "getGameMetadataOverride": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "appName",
          "type": "string",
          "maxLength": 256,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "{ title?, art_cover?, art_square? } | null",
      "valid": [["abc"]],
      "invalid": [[], [1], [null], ["a", "b"], [""]]
    },
    "getAnticheatInfo": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "appNamespace",
          "type": "string",
          "maxLength": 1024,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "AntiCheatInfo | null",
      "valid": [["abc"], [""]],
      "invalid": [[], [1], [null], ["a", "b"]]
    },
    "steamgriddb.searchGame": {
      "kind": "invoke",
      "slice": "info",
      "args": [
        {
          "name": "query",
          "type": "string",
          "maxLength": 256,
          "maxLengthUnit": "utf16"
        }
      ],
      "returns": "[{ id, name }]",
