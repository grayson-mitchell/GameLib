+// GameLib patch (Phase 34 Plan 02, D-06): the original
+// `requireWithFallback('lzma-native', 'lzma')` call is a runtime-computed
+// `require(variableName)` -- esbuild cannot statically resolve/bundle it,
+// and Node's Single Executable Application runtime restricts require() to
+// built-in modules only (no node_modules resolution at all, per
+// https://nodejs.org/api/single-executable-applications.html), so this
+// call always threw at sidecar startup once compiled into a self-contained
+// SEA binary. This project never installs the optional `lzma-native`
+// native-addon package (confirmed absent from package.json/node_modules),
+// so the fallback path was ALWAYS the one taken in every real environment
+// (dev, Electron, and Tauri sidecar alike) -- switching to a plain static
+// `require('lzma')` is behavior-identical, just resolvable at build time.
+const LZMA = require('lzma');
 const StdLib = require('@doctormckay/stdlib');
 const {ZSTDDecoder} = require('zstddec');
 
