{
  "name": "gamelib",
  "version": "0.7.0",
  "versionNames": {
    "stable": "Hajrudin",
    "beta": "Caesar Clown"
  },
  "upstream": {
    "project": "HeroicGamesLauncher",
    "repository": "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher",
    "baseVersion": "2.22.0",
    "baseCommit": "b5b5cad3fa2e822602d320b70788d87240fc056e"
  },
  "private": false,
  "main": "build/main/main.js",
  "homepage": "./",
  "license": "GPL-3.0-only",
  "description": "An Open Source Launcher for GOG, Epic Games, Amazon Games, and Steam",
  "repository": {
    "type": "Github",
    "url": "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher"
  },
  "author": {
    "name": "GameLib",
    "email": "heroicgameslauncher@protonmail.com"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "electron-vite dev --watch",
    "tauri:dev": "electron-vite build && pnpm build:sidecar && pnpm build:decompress-worker-dev && tauri dev",
    "build:sidecar": "esbuild --bundle --platform=node --target=node22 --format=cjs --packages=external --external:electron --external:electron-store --outfile=build/main/sidecar.js src/sidecar/index.ts",
    "build:decompress-worker-dev": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildDecompressWorkerDev.ts",
    "build:sidecar-sea": "pnpm build:sidecar && node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildSidecarSea.ts",
    "debug:react": "pnpm start & react-devtools",
    "codecheck": "tsc --noEmit",
    "planning-gates": "python3 meta/runPlanningGates.py",
    "find-deadcode": "ts-prune --error",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "test:e2e": "electron-vite build && cross-env CI=e2e xvfb-maybe -- playwright test",
    "release:linux": "pnpm clean:dist-linux && electron-vite build && electron-builder -p always --linux deb AppImage rpm pacman tar.xz",
    "release:mac": "pnpm clean:dist-mac && pnpm build-steam-bridge && electron-vite build && pnpm verify:runner-bundle build --arch=arm64 && electron-builder -p always --mac --x64 --arm64",
    "release:win": "pnpm clean:dist-win && electron-vite build && electron-builder -p always --win portable --x64",
    "release:updateFlathub:ci": "tsc flathub/update-flathub.ts --skipLibCheck --target es2015 --moduleResolution node --module commonjs && node flathub/update-flathub.js",
    "sign:win": "electron-vite build && electron-builder -p never --win nsis portable --x64 --arm64",
    "dist:linux": "pnpm clean:dist-linux && electron-vite build && electron-builder --linux",
    "dist:mac": "export CSC_IDENTITY_AUTO_DISCOVERY=false && pnpm clean:dist-mac && pnpm build-steam-bridge && electron-vite build && pnpm verify:runner-bundle build --arch=arm64 && electron-builder --mac",
    "dist:win": "pnpm clean:dist-win && electron-vite build && electron-builder --win",
    "dist:flatpak": "pnpm dist:linux appimage && pnpm flatpak:prepare && pnpm flatpak:build",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "flatpak:build": "cd flatpak-build && flatpak-builder build com.heroicgameslauncher.hgl.yml --install --force-clean --user",
    "flatpak:prepare": "node ./flatpak/prepareFlatpak.js",
    "flatpak:prepare-release": "node ./flatpak/prepareFlatpak.js release",
    "i18n": "i18next --silent",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/downloadHelperBinaries.ts",
    "lint-translations": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/lintTranslations.ts",
    "lint-translations:gamelib": "export LINT_TRANSLATIONS_NAMESPACES=gamelib && node meta/runTs.cjs --bundle --platform=node --target=node21 meta/lintTranslations.ts",
    "i18n-churn-guard": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/i18nCatalogChurnGuard.ts",
    "machine-fill-gamelib": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/machineFillGamelib.ts",
    "build-crossover-index": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildCrossoverIndex.ts",
    "gen-i18n-gate-scope": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/genI18nGateScope.ts",
    "gen-i18n-scope:rewrite": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/genI18nGateScope.ts --rewrite-scope",
    "gen-vtables": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/gen_vtables.ts",
    "build-steam-bridge": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildSteamBridgeShims.ts",
    "build-runners-onedir": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildRunnersOnedir.ts",
    "verify:runner-bundle": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/verifyRunnerBundle.ts",
    "clean:dist-mac": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=mac",
    "clean:dist-win": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=win",
    "clean:dist-linux": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=linux",
    "verify:updater-key": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/verifyUpdaterSigningKey.ts",
    "gen-tray-icon-variants": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/trayIconVariants.ts",
    "graph:viz": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/graphifyCodeViz.ts"
  },
  "dependencies": {
    "@fontsource/cabin": "^4.5.10",
    "@fontsource/rubik": "^4.5.14",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@node-steam/vdf": "^2.2.0",
    "@shockpkg/icon-encoder": "^2.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xhayper/discord-rpc": "1.3.0",
    "axios": "^1.13.5",
    "classnames": "^2.5.1",
    "easydl": "^1.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "fastest-levenshtein": "^1.0.16",
    "filesize": "^10.1.6",
    "fs-extra": "^11.3.0",
    "fuse.js": "^6.6.2",
    "graceful-fs": "^4.2.11",
    "i18next": "^22.5.1",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-backend": "^2.7.3",
    "ini": "^3.0.1",
    "intro.js": "^7.2.0",
    "intro.js-react": "^1.0.0",
    "json5": "^2.2.3",
    "lzma": "2.3.2",
    "lzma-native": "8.0.6",
    "plist": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-markdown": "^8.0.7",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.3",
    "rehype-raw": "^6.1.1",
    "sanitize-filename": "^1.6.3",
    "sanitize-html": "^2.16.0",
    "semver": "^7.7.1",
    "shlex": "^2.1.2",
    "short-uuid": "^4.2.2",
    "simple-keyboard": "^3.8.53",
    "source-map-support": "^0.5.21",
    "steam-session": "^1.9.4",
    "steam-shortcut-editor": "^3.1.3",
    "steam-user": "^5.3.0",
    "zod": "^3.24.3",
    "zstddec": "^0.1.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/graceful-fs": "^4.1.9",
    "@types/ini": "^1.3.34",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/sanitize-html": "^2.15.0",
    "@types/semver": "^7.7.0",
    "@types/source-map-support": "^0.5.10",
    "@types/steam-user": "^5.1.1",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import-x": "^4.15.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-xml-parser": "^5.5.7",
    "husky": "^8.0.3",
