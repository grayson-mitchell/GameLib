{
  "name": "gamelib",
  "version": "0.8.0",
  "versionNames": {
    "stable": "Hajrudin",
    "beta": "Caesar Clown"
  },
  "upstream": {
    "project": "HeroicGamesLauncher",
    "repository": "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher",
    "baseVersion": "2.22.0",
    "baseCommit": "b5b5cad3fa2e822602d320b70788d87240fc056e"
  },
  "private": false,
  "main": "build/main/main.js",
  "homepage": "./",
  "license": "GPL-3.0-only",
  "description": "An Open Source Launcher for GOG, Epic Games, Amazon Games, and Steam",
  "repository": {
    "type": "Github",
    "url": "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher"
  },
  "author": {
    "name": "GameLib",
    "email": "heroicgameslauncher@protonmail.com"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "tauri:dev": "cross-env GAMELIB_DEV_SECRET_VAULT=1 pnpm tauri:dev:run",
    "tauri:dev:keyring": "cross-env GAMELIB_DEV_KEYRING=1 pnpm tauri:dev:run",
    "tauri:dev:vault": "pnpm tauri:dev",
    "tauri:dev:run": "node meta/tauriDevPreflight.cjs && pnpm build:sidecar && tauri dev",
    "tauri:dev:packaged": "pnpm exec vite build && pnpm build:sidecar-sea && tauri build --debug",
    "build:sidecar": "esbuild --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=build/main/sidecar.js src/sidecar/index.ts",
    "build:sidecar-sea": "pnpm build:sidecar && node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildSidecarSea.ts",
    "debug:react": "pnpm start & npx react-devtools",
    "codecheck": "tsc --noEmit && tsc -p tsconfig.meta.json --noEmit",
    "perf:rerender": "jest --config meta/rerender/jest.config.js --runInBand",
    "planning-gates": "python3 meta/runPlanningGates.py",
    "find-deadcode": "knip --reporter json --no-exit-code | node meta/knipRatchet.cjs",
    "knip": "knip",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --maxWorkers=2 --silent",
    "test:x86-callback-wine": "cross-env GAMELIB_REQUIRE_WINE_HARNESS=1 jest --selectProjects Meta --runTestsByPath meta/__tests__/x86CallbackWineHarness.test.ts",
    "lint": "node meta/lintScoped.cjs",
    "boundaries": "depcruise --config .dependency-cruiser.cjs --output-type err-long src/backend",
    "steam-line-ceiling": "node meta/steamLineCeiling.cjs",
    "backend-di-ceilings": "node meta/backendDiCeilings.cjs",
    "lint:src": "node meta/lintScoped.cjs --src",
    "lint:tests": "node meta/lintScoped.cjs --tests",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "i18n": "i18next --silent",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/downloadHelperBinaries.ts",
    "pin:runner-digests": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/pinRunnerDigests.ts",
    "gen:ipc-contract": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/genIpcContract.ts",
    "check:ipc-contract": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/genIpcContract.ts --check",
    "check:build-bin-mirror": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/checkBuildBinMirror.ts",
    "capture:shell-scrollback": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/captureShellScrollback.ts",
    "smoke:exit-check": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/sidecarExitCheck.ts",
    "check:runner-invocations": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/checkRunnerInvocations.ts",
    "lint-translations": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/lintTranslations.ts",
    "lint-translations:gamelib": "export LINT_TRANSLATIONS_NAMESPACES=gamelib && node meta/runTs.cjs --bundle --platform=node --target=node21 meta/lintTranslations.ts",
    "i18n-churn-guard": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/i18nCatalogChurnGuard.ts",
    "rebrand-catalogs": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/rebrandUpstreamCatalogs.ts",
    "machine-fill-gamelib": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/machineFillGamelib.ts",
    "build-crossover-index": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildCrossoverIndex.ts",
    "gen-i18n-gate-scope": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/genI18nGateScope.ts",
    "gen-i18n-scope:rewrite": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/genI18nGateScope.ts --rewrite-scope",
    "check-csteamworks64-exports": "node meta/checkCsteamworks64Exports.cjs",
    "gen-vtables": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/gen_vtables.ts",
    "extract-proton-inventory": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/extractProtonInventory.ts",
    "build:overlay-archive": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildOverlayArchive.ts",
    "build:lsteamclient": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildLsteamclient.ts",
    "build:drm-native": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildDrmNativeParts.ts",
    "build:steamclient-layer-archive": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/buildSteamClientLayerArchive.ts",
    "scan-cli:build": "cargo build -p gamelib-scan-cli --manifest-path src-tauri/Cargo.toml",
    "depot-cli:build": "cargo build -p gamelib-depot-cli --manifest-path src-tauri/Cargo.toml",
    "steamfiles-cli:build": "cargo build -p gamelib-steamfiles-cli --manifest-path src-tauri/Cargo.toml",
    "depot-parity-sweep": "pnpm depot-cli:build && node meta/runTs.cjs --bundle --platform=node --target=node22 meta/depotParitySweep.ts",
    "bridge-census": "pnpm scan-cli:build && pnpm steamfiles-cli:build && node meta/runTs.cjs --bundle --platform=node --target=node21 meta/bridgeCensus.ts",
    "build-steam-bridge": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildSteamBridgeShims.ts",
    "build-runners-onedir": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/buildRunnersOnedir.ts",
    "verify:runner-bundle": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/verifyRunnerBundle.ts",
    "clean:dist-mac": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=mac",
    "clean:dist-win": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=win",
    "clean:dist-linux": "node meta/runTs.cjs --bundle --platform=node --target=node21 meta/cleanDist.ts --platform=linux",
    "verify:updater-key": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/verifyUpdaterSigningKey.ts",
    "sign:macos-resources": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/signMachOResources.ts",
    "gen-tray-icon-variants": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/trayIconVariants.ts",
    "graph:viz": "node meta/runTs.cjs --bundle --platform=node --target=node22 meta/graphifyCodeViz.ts",
    "smoke:sidecar": "node meta/sidecarStartupSmoke.cjs"
  },
  "dependencies": {
    "@fontsource/cabin": "^4.5.10",
    "@fontsource/rubik": "^4.5.14",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@shockpkg/icon-encoder": "^2.1.3",
    "@tauri-apps/api": "^2.11.1",
    "@xhayper/discord-rpc": "1.3.0",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "conf": "^10.2.0",
    "easydl": "^1.2.0",
    "fastest-levenshtein": "^1.0.16",
    "filesize": "^10.1.6",
    "fs-extra": "^11.3.0",
    "fuse.js": "^6.6.2",
    "graceful-fs": "^4.2.11",
    "i18next": "^22.5.1",
    "i18next-fs-backend": "^2.6.8",
    "i18next-http-backend": "^4.0.10",
    "ini": "^3.0.1",
    "intro.js": "^7.2.0",
    "intro.js-react": "^1.0.0",
    "json5": "^2.2.3",
    "lzma": "2.3.2",
    "plist": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.3.1",
    "react-markdown": "^8.0.7",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.3",
    "rehype-raw": "^6.1.1",
    "sanitize-filename": "^1.6.3",
    "sanitize-html": "^2.18.0",
    "semver": "^7.7.1",
    "shlex": "^2.1.2",
    "short-uuid": "^4.2.2",
    "simple-keyboard": "^3.8.53",
    "source-map-support": "^0.5.21",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "zod": "^4.6.7",
    "zstddec": "^0.1.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/graceful-fs": "^4.1.9",
    "@types/ini": "^1.3.34",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.15.0",
    "@types/semver": "^7.7.0",
    "@types/source-map-support": "^0.5.10",
    "@types/steam-user": "^5.1.1",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "18.7.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import-x": "^4.15.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-xml-parser": "^5.5.7",
    "husky": "^8.0.3",
    "i18next-parser": "^9.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "js-yaml": "^4.1.1",
    "knip": "6.42.1",
    "node-gyp": "^10.3.1",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.7.4",
    "sass": "^1.87.0",
    "tmp": "^0.2.4",
    "ts-jest": "^29.3.2",
    "ts-morph": "17.0.1",
    "type-fest": "^3.13.1",
    "typed-emitter": "^2.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "undici": "^7.24.0",
    "unimported": "^1.31.1",
    "vite-plugin-svgr": "^4.3.0",
    "xvfb-maybe": "^0.2.1"
  },
