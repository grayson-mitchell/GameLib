    "ts-morph": "17.0.1"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@^7": "^7.6.5",
      "steam-appticket": "^2.0.1",
      "adm-zip": "^0.6.1",
      "@xmldom/xmldom@^0.8": "^0.8.15",
      "undici@^6": "^6.29.1",
      "follow-redirects@^1": "^1.16.2",
      "source-map-js@^1": "^1.2.2",
      "ws@^8": "^8.21.0",
      "ajv@^8": "^8.18.0",
      "fast-uri@^3": "^3.1.8",
      "socks@^2": "^2.8.10",
      "lodash@^4": "^4.18.1",
      "nanoid@^3": "^3.3.18",
      "diff@^5": "^5.2.2",
      "yaml@^1": "^1.10.3"
    }
  }
