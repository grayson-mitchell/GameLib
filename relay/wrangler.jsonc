// Secrets must come ONLY from `wrangler secret put` (never in this file):
//   GITHUB_APP_PRIVATE_KEY, IP_HASH_SALT
{
  "name": "gamelib-fix-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // No request logging: IPs and headers must not be retained.
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": false,
  // CR-03: purge expired hashed-IP rate-limit buckets every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "REPO_OWNER": "grayson-mitchell",
    "REPO_NAME": "known-fixes",
    "BASE_BRANCH": "main",
    "GITHUB_APP_ID": "5572986",
    "GITHUB_INSTALLATION_ID": "177665978",
    "IP_HOURLY_LIMIT": "10",
    "DAILY_CREATE_CAP": "25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamelib-fix-relay",
      "database_id": "231222f4-6b99-4bfd-a0c5-a1048a8c084c",
      "migrations_dir": "migrations"
    }
  ],
  // vars and d1_databases are not inherited by environments.
  "env": {
    "staging": {
      "name": "gamelib-fix-relay-staging",
      "observability": { "enabled": false },
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["*/30 * * * *"] },
      "vars": {
        "REPO_OWNER": "grayson-mitchell",
        "REPO_NAME": "known-fixes-staging",
        "BASE_BRANCH": "main",
        "GITHUB_APP_ID": "5572986",
        "GITHUB_INSTALLATION_ID": "177665978",
        "IP_HOURLY_LIMIT": "10",
        "DAILY_CREATE_CAP": "25"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gamelib-fix-relay-staging",
          "database_id": "7bb3b29f-e09c-4ecf-a84e-4de3b294f50c",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
