// Secrets must come ONLY from `wrangler secret put` (never in this file):
//   GITHUB_APP_PRIVATE_KEY, IP_HASH_SALT
{
  "name": "gamelib-fix-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // No request logging: IPs and headers must not be retained.
  "observability": { "enabled": false },
  "workers_dev": true,
  "vars": {
    "REPO_OWNER": "grayson-mitchell",
    "REPO_NAME": "known-fixes",
    "BASE_BRANCH": "main",
    "GITHUB_APP_ID": "OPERATOR_FILLS",
    "GITHUB_INSTALLATION_ID": "OPERATOR_FILLS",
    "IP_HOURLY_LIMIT": "10",
    "DAILY_CREATE_CAP": "25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamelib-fix-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // vars and d1_databases are not inherited by environments.
  "env": {
    "staging": {
      "name": "gamelib-fix-relay-staging",
      "observability": { "enabled": false },
      "workers_dev": true,
      "vars": {
        "REPO_OWNER": "grayson-mitchell",
        "REPO_NAME": "known-fixes-staging",
        "BASE_BRANCH": "main",
        "GITHUB_APP_ID": "OPERATOR_FILLS",
        "GITHUB_INSTALLATION_ID": "OPERATOR_FILLS",
        "IP_HOURLY_LIMIT": "10",
        "DAILY_CREATE_CAP": "25"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gamelib-fix-relay-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
