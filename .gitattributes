pnpm-lock.yaml linguist-generated=true

# Windows checkouts with core.autocrlf=true materialise the working tree as
# CRLF, which fails `prettier --check .` (Prettier 3 defaults endOfLine to
# "lf") and breaks LF-fixture source-text tests (tauriShellSource.test.ts).
# Pin every text file to LF on checkout, regardless of the checking-out
# machine's core.autocrlf. See todo 2026-09-22-pre-push-hook-cannot-pass-on-a-windows-checkout.md.
* text=auto eol=lf

# These 6 files are raw spike-captured terminal output, committed byte-exact
# with CRLF on purpose (see .planning/spikes/*). They must never be
# normalised by the `* text=auto eol=lf` rule above -- this line must stay
# AFTER it, since later .gitattributes lines win.
*.evidence.txt -text

# Phase 63-03: synthetic scanner fixtures are binary; never normalise line endings.
src-tauri/crates/gamelib-scan/tests/fixtures/**/*.bin binary
src-tauri/crates/gamelib-scan/tests/fixtures/**/winemac.so binary
src-tauri/crates/gamelib-scan/tests/fixtures/**/*.exe binary
src-tauri/crates/gamelib-scan/tests/fixtures/**/*.dll binary

# Phase 75-02: synthetic Steam local-file fixtures (CRLF, BOM, non-UTF-8, binary KV)
# must be stored byte-exact on every OS.
src-tauri/crates/gamelib-steamfiles/tests/fixtures/** -text
src-tauri/crates/gamelib-steamfiles/tests/fixtures/shortcuts/** binary
