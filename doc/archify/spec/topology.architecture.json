  "cards": [
    {
      "dot": "cyan",
      "title": "Transport",
      "items": [
        "Renderer reaches Rust through exactly 4 registered commands",
        "Shell to sidecar is a private stdio pipe, not loopback TCP",
        "RPC ids are strings \u2014 Steam uses 64-bit values"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "Shell holds every OS surface: keychain, dialogs, tray, cookies",
        "Sidecar holds every business decision and all persistence",
        "Renderer holds only window chrome and the 4 relay commands"
      ]
    },
    {
      "dot": "rose",
      "title": "Asymmetry",
      "items": [
        "rustInvoke travels sidecar to shell only",
        "isValidRequest() rejects it inbound (T-28-03b)"
      ]
    }
  ]
