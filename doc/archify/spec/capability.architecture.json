  "cards": [
    {
      "dot": "rose",
      "title": "Why the list is explicit",
      "items": [
        "GameLib renders untrusted remote content inside `main`",
        "Tauri offers no webview isolation boundary, so grants are inherited",
        "core:window:default was refused wholesale and re-granted line by line"
      ]
    },
    {
      "dot": "emerald",
      "title": "Refusals that are load-bearing",
      "items": [
        "dialog:allow-open \u2014 Rust calls app.dialog() instead",
        "deep-link \u2014 the shell subscribes to on_open_url from Rust",
        "notification:default \u2014 only is-permission-granted is granted, and it is required"
      ]
    },
    {
      "dot": "amber",
      "title": "The invariant to never break",
      "items": [
        "No capability may declare a `remote.urls` grant while store-embed is in scope",
        "Child window labels must never be added to the windows array"
      ]
    }
  ]
