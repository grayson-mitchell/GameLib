  "cards": [
    {
      "dot": "cyan",
      "title": "One-way dependency rule",
      "items": [
        "src/common imports neither backend nor frontend, and is imported by both",
        "InstallErrorAction lives in common purely to honour that rule",
        "The Rust shell mirrors the Runner union by hand \u2014 no shared codegen"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where the weight sits",
      "items": [
        "143,471 lines total; backend is half of it",
        "372 test files, 206 of them against the backend",
        "45 meta/ scripts run i18n, gate and binary-download tooling"
      ]
    },
    {
      "dot": "amber",
      "title": "Structural risk",
      "items": [
        "main.rs is 13,152 lines in one file with no mod decomposition",
        "Frontend state is mid-migration: Context and zustand both live",
        "The Runner mirror in Rust has no machine check"
      ]
    }
  ]
