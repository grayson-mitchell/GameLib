  "cards": [
    {
      "dot": "cyan",
      "title": "The seam",
      "items": [
        "Adding a store is one registry line plus an implementation folder",
        "`satisfies Record<Runner, LibraryManager>` turns an omission into a type error",
        "Edges from the registry carry no label \u2014 the map key is the target's own name"
      ]
    },
    {
      "dot": "emerald",
      "title": "Asymmetry between runners",
      "items": [
        "Epic, GOG and Amazon delegate downloads to a helper binary",
        "Steam implements depot download and a macOS API shim in-process",
        "sideload has no user.ts because it has nothing to authenticate against"
      ]
    },
    {
      "dot": "amber",
      "title": "The dropped member",
      "items": [
        "`zoom` stays in the union and in the Rust mirror deliberately",
        "Removing it would make the Rust allow-list a diverging copy, not a mirror"
      ]
    }
  ]
}